
import logging
import math
from typing import Optional

from ..config import settings
from .client import get_client

log = logging.getLogger("exec")

SIDE = {"BUY": "BUY", "SELL": "SELL"}

# ---------- helpers de precisión / filtros ----------

def _decimals_from_step(step: float) -> int:
    s = f"{step:.16f}".rstrip("0")
    if "." in s:
        return len(s.split(".")[1])
    return 0

def _symbol_filters(symbol: str):
    """Devuelve dict con price_step, qty_step, min_notional, min_qty, max_leverage."""
    cli = get_client().client
    info = cli.futures_exchange_info()
    sinfo = next(s for s in info["symbols"] if s["symbol"] == symbol)

    price_step = qty_step = None
    min_notional = 0.0
    min_qty = 0.0
    for f in sinfo["filters"]:
        if f["filterType"] == "PRICE_FILTER":
            price_step = float(f["tickSize"])
        elif f["filterType"] == "LOT_SIZE":
            qty_step = float(f["stepSize"])
            min_qty = float(f["minQty"])
        elif f["filterType"] == "MIN_NOTIONAL":
            min_notional = float(f.get("notional", 0.0))

    # max leverage
    try:
        br = cli.futures_leverage_bracket(symbol=symbol)
        max_lev = max(int(x.get("initialLeverage", 20)) for x in br[0]["brackets"])
    except Exception:
        max_lev = 20

    return {
        "price_step": price_step or 0.1,
        "qty_step": qty_step or 0.001,
        "min_notional": float(min_notional or 0.0),
        "min_qty": float(min_qty or 0.0),
        "max_leverage": max_lev,
    }

def _round_price(symbol: str, price: float) -> float:
    st = _symbol_filters(symbol)
    step = st["price_step"]
    return math.floor(price / step) * step

def _round_qty(symbol: str, qty: float) -> float:
    st = _symbol_filters(symbol)
    step = st["qty_step"]
    return math.floor(qty / step) * step

def _price_to_str(symbol: str, price: float) -> str:
    st = _symbol_filters(symbol)
    dec = _decimals_from_step(st["price_step"])
    return f"{_round_price(symbol, price):.{dec}f}"

def _qty_to_str(symbol: str, qty: float) -> str:
    st = _symbol_filters(symbol)
    dec = _decimals_from_step(st["qty_step"])
    return f"{_round_qty(symbol, qty):.{dec}f}"

# ---------- funciones de exchange ----------

def last_price(symbol: str) -> float:
    p = get_client().client.futures_symbol_ticker(symbol=symbol)
    return float(p["price"])

def _change_leverage_if_needed(symbol: str, target_lev: int):
    cli = get_client().client
    try:
        # No hay endpoint directo de "get current leverage", cambiamos si tiene sentido.
        cli.futures_change_leverage(symbol=symbol, leverage=target_lev)
        log.info(f"risk:[{symbol}] leverage set to {target_lev}")
    except Exception as e:
        log.info(f"risk:[{symbol}] leverage change: {e}")

def market_order(side: str, symbol: str, qty: float, reduce_only: bool = False):
    params = dict(
        symbol=symbol,
        side=side,
        type="MARKET",
        quantity=_qty_to_str(symbol, qty),
        recvWindow=settings.recv_window,
    )
    if reduce_only:
        params["reduceOnly"] = "true"
    return get_client().client.futures_create_order(**params)

def limit_order(side: str, symbol: str, qty: float, price: float, tif: str = "GTC", reduce_only: bool = False):
    params = dict(
        symbol=symbol,
        side=side,
        type="LIMIT",
        timeInForce=tif,
        quantity=_qty_to_str(symbol, qty),
        price=_price_to_str(symbol, price),
        recvWindow=settings.recv_window,
    )
    if reduce_only:
        params["reduceOnly"] = "true"
    return get_client().client.futures_create_order(**params)

def place_tp_sl(symbol: str, side_open: str, tp_price: Optional[float], sl_price: Optional[float]):
    """Coloca TP/SL en MARK_PRICE con buffers de 2 ticks para evitar 'Order would immediately trigger'."""
    st = _symbol_filters(symbol)
    cli = get_client().client

    try:
        px = last_price(symbol)
    except Exception:
        px = None

    tick = st["price_step"]
    opp = "SELL" if side_open == "BUY" else "BUY"

    def _buf_up(x):   # asegura distancia mínima hacia arriba
        return x + 2 * tick
    def _buf_dn(x):   # asegura distancia mínima hacia abajo
        return x - 2 * tick

    # Ajuste anti-trigger según lado
    if px is not None:
        if side_open == "BUY":
            if sl_price is not None:
                sl_price = min(sl_price, _buf_dn(px))
            if tp_price is not None:
                tp_price = max(tp_price, _buf_up(px))
        else:  # SHORT
            if sl_price is not None:
                sl_price = max(sl_price, _buf_up(px))
            if tp_price is not None:
                tp_price = min(tp_price, _buf_dn(px))

    if tp_price is not None:
        try:
            get_client().client.futures_create_order(
                symbol=symbol,
                side=opp,
                type="TAKE_PROFIT_MARKET",
                stopPrice=_price_to_str(symbol, tp_price),
                closePosition="true",
                workingType="MARK_PRICE",
                priceProtect="true",
                recvWindow=settings.recv_window,
            )
        except Exception as e:
            log.warning(f"TP error: {e}")

    if sl_price is not None:
        try:
            get_client().client.futures_create_order(
                symbol=symbol,
                side=opp,
                type="STOP_MARKET",
                stopPrice=_price_to_str(symbol, sl_price),
                closePosition="true",
                workingType="MARK_PRICE",
                priceProtect="true",
                recvWindow=settings.recv_window,
            )
        except Exception as e:
            log.warning(f"SL error: {e}")

# ---------- control de riesgo extra ----------

def _current_open_positions_count() -> int:
    """Cuenta cuántos símbolos tienen posición abierta (amt != 0)."""
    cli = get_client().client
    try:
        pos = cli.futures_position_information()
        return sum(1 for p in pos if abs(float(p.get("positionAmt", "0"))) > 0.0)
    except Exception as e:
        log.warning(f"pos_count error: {e}")
        return 0

def _can_open_new_position() -> bool:
    limit = int(getattr(settings, "max_open_positions", int(getattr(settings, "MAX_OPEN_POSITIONS", 5))))
    return _current_open_positions_count() < limit



def _qty_from_margin_cap(symbol: str, price: float) -> float:
    """
    Nueva lógica:
    1) qty_target = ceil_to_step(max(minQty, minNotional/price))
    2) notional_target = price * qty_target
    3) lev_req = ceil(notional_target / max_margin_usdt)
       - si lev_req <= max_leverage -> fijar leverage y usar qty_target
       - si no, no abrir (devuelve 0)
    """
    st = _symbol_filters(symbol)
    margin_cap = float(getattr(settings, "max_margin_usdt", float(getattr(settings, "MAX_MARGIN_USDT", 1.0))))
    min_notional = float(st["min_notional"] or 0.0)
    min_qty = float(st["min_qty"] or 0.0)
    step = float(st["qty_step"] or 0.001)
    max_lev = int(st["max_leverage"] or 20)

    if price <= 0:
        return 0.0

    # qty mínima que cumple minNotional (y minQty), redondeando HACIA ARRIBA al step
    def round_up_step(x, step):
        return math.ceil(x / step) * step

    qty_target = max(min_qty, min_notional / price) if min_notional > 0 else max(min_qty, step)
    qty_target = round_up_step(qty_target, step)

    notional_target = price * qty_target
    if notional_target <= 0:
        return 0.0

    # leverage requerido para cumplir el notional con margen tope
    lev_req = math.ceil(notional_target / max(margin_cap, 1e-9))
    if lev_req < 1:
        lev_req = 1

    # si ni con el leverage máximo se alcanza, abortar
    if lev_req > max_lev:
        log.warning(f"[{symbol}] minNotional={min_notional:.4f} step={step} minQty={min_qty} "
                    f"-> qty_target={qty_target} notional_target={notional_target:.4f}; "
                    f"lev_req={lev_req} > max_lev={max_lev} con margen_cap={margin_cap}. Omitiendo.")
        return 0.0

    # aplicar leverage requerido (o menor si ya suficiente)
    _change_leverage_if_needed(symbol, lev_req)

    # validación final de exchange filters
    qty_ok = _round_qty(symbol, qty_target)
    if qty_ok <= 0:
        return 0.0

    # verificación por si el redondeo bajó el notional por debajo de minNotional
    if price * qty_ok + 1e-9 < min_notional:
        qty_ok = round_up_step(min_notional / price, step)
        qty_ok = _round_qty(symbol, qty_ok)

    if qty_ok <= 0 or price * qty_ok + 1e-9 < min_notional:
        log.warning(f"[{symbol}] No se pudo ajustar qty al minNotional tras redondeos. "
                    f"minNotional={min_notional}, price={price}, step={step}, minQty={min_qty}")
        return 0.0

    log.info(f"[{symbol}] qty={qty_ok} notional≈{price*qty_ok:.4f} lev={lev_req} "
             f"(minNotional={min_notional}, margin_cap={margin_cap}, max_lev={max_lev})")
    return qty_ok

    # qty mínima que cumple minNotional (y minQty), redondeando HACIA ARRIBA al step
    def round_up_step(x, step):
        return math.ceil(x / step) * step

    qty_target = max(min_qty, min_notional / price) if min_notional > 0 else max(min_qty, step)
    qty_target = round_up_step(qty_target, step)

    notional_target = price * qty_target
    if notional_target <= 0:
        return 0.0

    # leverage requerido para cumplir el notional con margen tope
    lev_req = math.ceil(notional_target / max(margin_cap, 1e-9))
    if lev_req < 1:
        lev_req = 1

    # si ni con el leverage máximo se alcanza, abortar
    if lev_req > max_lev:
        log.warning(f"[{symbol}] minNotional={min_notional:.4f} step={step} minQty={min_qty} "
                    f"-> qty_target={qty_target} notional_target={notional_target:.4f}; "
                    f"lev_req={lev_req} > max_lev={max_lev} con margen_cap={margin_cap}. Omitiendo.")
        return 0.0

    # aplicar leverage requerido (o menor si ya suficiente)
    _change_leverage_if_needed(symbol, lev_req)

    # validación final de exchange filters
    qty_ok = _round_qty(symbol, qty_target)
    if qty_ok <= 0:
        return 0.0

    # verificación por si el redondeo bajó el notional por debajo de minNotional
    if price * qty_ok + 1e-9 < min_notional:
        qty_ok = round_up_step(min_notional / price, step)
        qty_ok = _round_qty(symbol, qty_ok)

    if qty_ok <= 0 or price * qty_ok + 1e-9 < min_notional:
        log.warning(f"[{symbol}] No se pudo ajustar qty al minNotional tras redondeos. "
                    f"minNotional={min_notional}, price={price}, step={step}, minQty={min_qty}")
        return 0.0

    log.info(f"[{symbol}] qty={qty_ok} notional≈{price*qty_ok:.4f} lev={lev_req} "
             f"(minNotional={min_notional}, margin_cap={margin_cap}, max_lev={max_lev})")
    return qty_ok

# ---------- flujo de entrada ----------

def enter_position(direction: str, use_limit: bool = True, limit_offset_bps: int = 3, tp_rr: float = 1.5, sl_rr: float = 1.0, symbol: str | None = None):
    symbol = symbol or settings.symbol

    if not _can_open_new_position():
        log.info(f"[{symbol}] límite de posiciones abiertas alcanzado; no se abre nueva.")
        return

    px = last_price(symbol)
    qty = _qty_from_margin_cap(symbol, px)

    if qty <= 0:
        raise ValueError(f"[{symbol}] Qty inválida para el margen configurado (posible minNotional alto)")

    if direction == "LONG":
        side_open = SIDE["BUY"]
        sl = px * (1 - 0.002 * sl_rr)
        tp = px * (1 + 0.003 * tp_rr)
        if use_limit:
            price = px * (1 - limit_offset_bps/10000)
            limit_order(side_open, symbol, qty, price)
        else:
            market_order(side_open, symbol, qty)
        place_tp_sl(symbol, side_open, tp_price=tp, sl_price=sl)

    elif direction == "SHORT":
        side_open = SIDE["SELL"]
        sl = px * (1 + 0.002 * sl_rr)
        tp = px * (1 - 0.003 * tp_rr)
        if use_limit:
            price = px * (1 + limit_offset_bps/10000)
            limit_order(side_open, symbol, qty, price)
        else:
            market_order(side_open, symbol, qty)
        place_tp_sl(symbol, side_open, tp_price=tp, sl_price=sl)

    else:
        log.info(f"[{symbol}] Dirección = NEUTRAL. No se abre posición.")
