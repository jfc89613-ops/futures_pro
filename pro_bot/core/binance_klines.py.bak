
import math
import time
import pandas as pd
from .client import get_client

# Mapa de minutos para intervalos de Binance
_MINUTES = {
    "1m":1,"3m":3,"5m":5,"15m":15,"30m":30,
    "1h":60,"2h":120,"4h":240,"6h":360,"8h":480,"12h":720,
    "1d":1440
}

_COLS = [
    "open_time","open","high","low","close","volume",
    "close_time","quote_asset_volume","number_of_trades",
    "taker_buy_base_asset_volume","taker_buy_quote_asset_volume","ignore"
]

def _to_df(rows):
    df = pd.DataFrame(rows, columns=_COLS)
    # cast
    for c in ["open","high","low","close","volume","quote_asset_volume",
              "taker_buy_base_asset_volume","taker_buy_quote_asset_volume"]:
        df[c] = pd.to_numeric(df[c], errors="coerce")
    # index temporal: UTC **naive** (compat con features/resampling)
    df["open_time"] = pd.to_datetime(df["open_time"], unit="ms", utc=True).dt.tz_convert("UTC").dt.tz_localize(None)
    df = df.set_index("open_time").sort_index()
    return df[["open","high","low","close","volume"]]

def fetch_klines(symbol: str, interval: str, *, limit: int|None=None,
                 start: int|None=None, end: int|None=None) -> pd.DataFrame:
    """
    Trae klines de Binance Futuros.
    - Si se pasa 'limit', usa una sola llamada con ese límite (máx usual 1500).
    - Si no hay 'limit', y se pasa start/end (ms epoch), pagina hasta cubrir rango.
    Devuelve DataFrame con columnas: open,high,low,close,volume e índice datetime (UTC naive).
    """
    cli = get_client().client

    # Caso simple: limit
    if limit is not None:
        rows = cli.futures_klines(symbol=symbol, interval=interval, limit=limit)
        return _to_df(rows)

    # Caso rango: start/end en ms (si no hay, cae a último 'limit' por compat)
    if start is None and end is None:
        rows = cli.futures_klines(symbol=symbol, interval=interval, limit=1000)
        return _to_df(rows)

    # Paginación por rango
    rows_all = []
    cur_start = start
    while True:
        rows = cli.futures_klines(symbol=symbol, interval=interval,
                                  startTime=cur_start, endTime=end, limit=1500)
        if not rows:
            break
        rows_all.extend(rows)
        last_close = rows[-1][6]  # close_time
        # avanzar 1 ms para no repetir
        cur_start = int(last_close) + 1
        # break de seguridad para evitar loops infinitos
        if len(rows) < 1500:
            break
        # dormir pequeño para respetar rate-limit
        time.sleep(0.05)

    if not rows_all:
        return pd.DataFrame(columns=["open","high","low","close","volume"])
    return _to_df(rows_all)
