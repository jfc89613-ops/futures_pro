import os, queue, threading, logging, yaml, time, json
import pandas as pd
from datetime import datetime, timedelta, timezone

from pro_bot.config import settings
from pro_bot.core.client import get_client
from pro_bot.core.ws import start_manager, add_multiplex_kline
from pro_bot.core.execution import enter_position, _can_open_new_position
from pro_bot.core.binance_klines import fetch_klines
from pro_bot.core.top_symbols import top_usdtm_by_quote_volume

from pro_ml.core.features.microstructure import build_features
from pro_ml.core.live.inference_multi import LiveModelPerSymbol

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("multi")

# Cargar config ML
CFG_PATH = os.getenv("ML_CFG", "configs/ml.yaml")
with open(CFG_PATH, "r") as f:
    cfg = yaml.safe_load(f)

serv = cfg.get("serving", {})
lm = LiveModelPerSymbol(
    root="outputs/models",
    prob_long=serv.get("prob_long", 0.57),
    prob_short=serv.get("prob_short", 0.43),
)

# Descubrir símbolos
symbols_env = os.getenv("SYMBOLS", "").strip()
if symbols_env:
    SYMBOLS = [s.strip().upper() for s in symbols_env.split(",") if s.strip()]
else:
    topn = int(os.getenv("TOPN", "20").split("#",1)[0].strip() or "20")
    SYMBOLS = top_usdtm_by_quote_volume(topn)

log.info(f"Symbols: {SYMBOLS}")

# Buffers por símbolo
KQ = {s: queue.Queue() for s in SYMBOLS}
DF = {s: pd.DataFrame(columns=["open","high","low","close","volume"]) for s in SYMBOLS}

def warmup(symbol: str):
    lookback_min = int(os.getenv("WARMUP_LOOKBACK_MIN", "2000"))
    interval = os.getenv("WARMUP_INTERVAL", "1m")
    end = datetime.now(timezone.utc)
    start = end - timedelta(minutes=lookback_min)
    df = fetch_klines(symbol, interval=interval, start=start, end=end)
    DF[symbol] = df
    log.info(f"[{symbol}] warmup rows: {len(df)}")

def on_multiplex(msg):
    """
    Callback único para streams multiplexados: rutea por símbolo.
    Formatos posibles:
      {"stream":"btcusdt@kline_1m","data":{...}}   # común
      o directamente el dict plano con 'e':'kline'
    """
    try:
        if isinstance(msg, str):
            msg = json.loads(msg)
        data = msg.get("data", msg)
        evt = data.get("e") or data.get("eventType")
        if evt not in ("kline", "continuous_kline"):
            return

        k = data.get("k") or data.get("kc") or data
        if not k.get("x"):  # solo vela cerrada
            return

        # Obtener símbolo desde el stream (btcusdt@kline_1m) o del payload
        stream = msg.get("stream", "")
        sym = (stream.split("@",1)[0]).upper() if "@" in stream else (data.get("s") or k.get("s"))
        if not sym:
            return
        if sym not in KQ:
            # Puede aparecer si Binance envía algo extra: ignoramos
            return

        ts = int(k["t"]) // 1000
        row = {
            "open":   float(k["o"]),
            "high":   float(k["h"]),
            "low":    float(k["l"]),
            "close":  float(k["c"]),
            "volume": float(k["v"]),
        }
        # Si quieres ver cierres (activar DEBUG arriba)
        log.debug(f"[{sym}] kline closed t={ts} close={row['close']} vol={row['volume']}")
        KQ[sym].put((ts, row))
    except Exception as e:
        log.warning(f"[on_multiplex] error: {e}")

def worker(symbol: str):
    # Inferencia inmediata tras warmup (sanity check)
    warmup(symbol)
    try:
        if not DF[symbol].empty:
            feats_df = build_features(DF[symbol], cfg)
            if len(feats_df) >= 10:
                latest = feats_df.iloc[-1]
                decision, prob = lm.decide(symbol, latest)
                log.info(f"[{symbol}] (warmup check) ML Decision: {decision} p={prob:.3f}")
                if decision in ("LONG", "SHORT"):
                    log.info(f"[{symbol}] (warmup check) Entering {decision} via LIMIT")
                    enter_position(decision, use_limit=True, symbol=symbol)
    except Exception as e:
        log.warning(f"[{symbol}] warmup check error: {e}")

    # Consumir del queue continuamente
    while True:
        try:
            ts, row = KQ[symbol].get(timeout=180)
        except Exception:
            log.warning(f"[{symbol}] no klines in 180s; revisa conexión/streams")
            continue

        idx = pd.to_datetime(ts, unit="s", utc=True).tz_convert(None)
        from pandas import Series
        row = {k: float(v) for k,v in row.items()}
        DF[symbol].loc[idx] = row

        feats_df = build_features(DF[symbol], cfg)
        if len(feats_df) < 10:
            continue
        latest = feats_df.iloc[-1]

        decision, prob = lm.decide(symbol, latest)
        log.info(f"[{symbol}] ML Decision: {decision} p={prob:.3f}")
        if decision in ("LONG", "SHORT"):
            try:
                log.info(f"[{symbol}] Entering {decision} via LIMIT")
                enter_position(decision, use_limit=True, symbol=symbol)
            except Exception as e:
                log.warning(f"[{symbol}] enter error: {e}")

def main():
    get_client()       # inicializa cuenta/pos. mode, leverage, etc.
    start_manager()    # inicia TWM (único)
    # Un solo socket multiplex para TODOS los símbolos
    add_multiplex_kline(SYMBOLS, settings.kline_interval, on_multiplex)

    # Un hilo por símbolo solo para procesar su cola y decidir/operar
    threads = []
    for s in SYMBOLS:
        th = threading.Thread(target=worker, args=(s,), daemon=True)
        threads.append(th)
        th.start()
        time.sleep(0.1)

    for th in threads:
        th.join()

if __name__ == "__main__":
    main()
